# Core
SECRET_KEY=replace-with-a-long-random-secret
APP_BASE_URL=https://your-domain.com
COOKIE_SECURE=1
PORT=5000

# Production DB: omit for local SQLite, set for Postgres deployment
DATABASE_URL=postgresql://user:password@host:5432/lead_rescue
DATABASE_PATH=lead_rescue.db

# AI
OPENAI_API_KEY=

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Email + account security
RESEND_API_KEY=
AUTH_FROM_EMAIL=accounts@your-domain.com
AUTH_FROM_NAME=Lead Rescue AI

# SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Meta Lead Ads + OAuth
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=choose-a-long-random-verify-token
META_GRAPH_VERSION=v25.0

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Scheduler / cron
AUTOMATION_CRON_TOKEN=choose-a-long-random-token
